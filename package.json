{
  "name": "pablo-escobare-dashboard",
  "version": "1.0.0",
  "description": "Pablo Escobare Admin Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --ia32"
  },
  "build": {
    "appId": "com.pablo.dashboard",
    "productName": "Pablo Escobare Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "18.3.15",
    "electron-builder": "^24.9.0"
  }
}
